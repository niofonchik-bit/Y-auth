NODE_ENV=development
PORT=3000
AUTH_ISSUER=http://localhost:3000
AUTH_WEB_DEV_URL=http://localhost:5174
DATABASE_URL=postgresql://user:password@host:5432/y_auth?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/y_auth?sslmode=require
REDIS_URL=rediss://default:password@host:6379
OIDC_JWKS={"keys":[]}
OIDC_COOKIE_KEYS=replace-with-two-comma-separated-secrets-at-least-32-bytes-each
SESSION_HMAC_SECRET=replace-with-at-least-32-bytes
CSRF_HMAC_SECRET=replace-with-at-least-32-bytes
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-bytes
MFA_ENCRYPTION_KEY=
MFA_ENABLED=false
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
AVATAR_ENABLED=false
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
APP_ENVIRONMENT=development
VITE_APP_ENVIRONMENT=development
RESEND_API_KEY=
MAIL_FROM=Y.auth <auth@example.com>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_MODE=off
EMAIL_VERIFICATION_TTL_SECONDS=86400
ENABLE_SWAGGER=true
LOG_LEVEL=info
TRUST_PROXY=false
