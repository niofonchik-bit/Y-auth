{
	"name": "y-auth-service",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.0.0 <25"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:web": "vite",
		"build": "npm run build:server && npm run build:web",
		"build:server": "tsc -p tsconfig.server.json",
		"build:web": "vite build",
		"start": "node dist/server/src/server.js",
		"lint": "biome lint . && prettier --check .",
		"lint:fix": "biome lint --write . && prettier --write .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
		"test": "npm run test:unit",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:security": "vitest run --config vitest.security.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:seed": "tsx scripts/e2e-seed.ts",
		"test:e2e:fixture": "vite --config tests/e2e/fixture/vite.config.ts",
		"benchmark": "tsx scripts/benchmark.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"admin:create": "tsx scripts/admin-create.ts",
		"keys:generate": "tsx scripts/keys-generate.ts",
		"secrets:generate": "tsx scripts/secrets-generate.ts"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@fastify/cookie": "11.1.2",
		"@fastify/formbody": "9.0.0",
		"@fastify/helmet": "13.1.1",
		"@fastify/middie": "9.3.3",
		"@fastify/static": "10.1.3",
		"@fastify/swagger": "9.8.1",
		"@fastify/swagger-ui": "6.1.1",
		"@mui/icons-material": "9.4.0",
		"@mui/material": "9.4.0",
		"argon2": "0.45.1",
		"drizzle-orm": "0.45.2",
		"fastify": "5.12.1",
		"ioredis": "6.0.0",
		"jose": "6.2.10",
		"oidc-provider": "9.12.0",
		"postgres": "3.4.9",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router-dom": "7.18.3",
		"ua-parser-js": "2.0.10",
		"zod": "4.1.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@playwright/test": "1.62.1",
		"@types/node": "26.4.0",
		"@types/oidc-provider": "9.11.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"drizzle-kit": "0.31.10",
		"oidc-client-ts": "3.5.0",
		"prettier": "3.9.6",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
